# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/inventory_sync

# Redis
REDIS_URL=redis://localhost:6379/0

# Supplier
SUPPLIER_SPREADSHEET_PATH=/data/supplier_inventory.xlsx
SUPPLIER_API_URL=https://api.supplier.example.com/inventory
SUPPLIER_API_KEY=your_supplier_api_key_here

# Marketplace 1
MARKETPLACE_1_URL=https://marketplace1.example.com
MARKETPLACE_1_USER=your_marketplace1_username
MARKETPLACE_1_PASS=your_marketplace1_password

# Marketplace 2
MARKETPLACE_2_URL=https://marketplace2.example.com
MARKETPLACE_2_USER=your_marketplace2_username
MARKETPLACE_2_PASS=your_marketplace2_password

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
ALERT_EMAIL=alerts@yourcompany.com

# Paths
SCREENSHOTS_DIR=/app/screenshots

# Logging
LOG_LEVEL=INFO

# Sync configuration
SYNC_INTERVAL_MINUTES=60
LOW_STOCK_THRESHOLD=10
PRICE_MARKUP_PERCENT=15.0
